    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        roseGold: '#B8860B',
                        burgundy: '#6B1D2F',
                        cream: '#FDFBF7',
                        softPink: '#F7E7E6',
                        accentGold: '#D4AF37'
                    },
                    fontFamily: {
                        script: ['Alex Brush', 'cursive'],
                        serif: ['Cormorant Garamond', 'serif'],
                        sans: ['Montserrat', 'sans-serif']
                    }
                }
            }
        }
