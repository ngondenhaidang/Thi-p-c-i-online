                <div class="overflow-hidden rounded-2xl shadow-lg group cursor-pointer" data-aos="zoom-in" data-aos-delay="300" onclick="openLightbox('https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=1200&q=80')">
                    <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=600&q=80" alt="Wedding Photo 4" class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-700">
                </div>

                <div class="overflow-hidden rounded-2xl shadow-lg group cursor-pointer" data-aos="zoom-in" data-aos-delay="400" onclick="openLightbox('https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1200&q=80')">
                    <img src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=600&q=80" alt="Wedding Photo 5" class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-700">
                </div>

                <div class="overflow-hidden rounded-2xl shadow-lg group cursor-pointer" data-aos="zoom-in" data-aos-delay="500" onclick="openLightbox('https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=1200&q=80')">
                    <img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=600&q=80" alt="Wedding Photo 6" class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-700">
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 6: RSVP FORM -->
    <section id="rsvp" class="py-24 bg-cream relative">
        <div class="max-w-3xl mx-auto px-4">
            <div class="bg-white rounded-3xl p-8 md:p-12 shadow-2xl border border-amber-200/60" data-aos="flip-up" data-aos-duration="1000">
                <div class="text-center mb-10">
                    <span class="font-serif text-xs uppercase tracking-[0.3em] text-amber-700 block mb-2">RSVP</span>
                    <h2 class="font-script text-5xl text-burgundy">Xác Nhận Tham Dự</h2>
                    <p class="text-gray-500 font-serif text-sm mt-2">Sự hiện diện của quý khách là niềm vinh hạnh lớn cho gia đình chúng tôi!</p>
                    <div class="w-16 h-0.5 bg-amber-600 mx-auto mt-4"></div>
                </div>

                <form id="rsvpForm" onsubmit="handleRSVP(event)" class="space-y-6">
                    <div>
                        <label class="block font-serif text-sm font-semibold text-gray-700 mb-2">Họ và Tên của Bạn *</label>
                        <input type="text" required placeholder="Nhập họ và tên..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none transition-all">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block font-serif text-sm font-semibold text-gray-700 mb-2">Số Điện Thoại</label>
                            <input type="tel" placeholder="0901 234 567" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none transition-all">
                        </div>
                        <div>
                            <label class="block font-serif text-sm font-semibold text-gray-700 mb-2">Bạn là khách của?</label>
                            <select class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none transition-all">
                                <option value="groom">Chú Rể (Minh Tú)</option>
                                <option value="bride">Cô Dâu (Khánh Linh)</option>
                                <option value="both">Cả Hai</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block font-serif text-sm font-semibold text-gray-700 mb-2">Bạn Có Thể Đến Tham Dự Không?</label>
                        <div class="grid grid-cols-2 gap-4">
                            <label class="flex items-center p-4 border border-gray-200 rounded-xl cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="attendance" value="yes" checked class="text-amber-600 focus:ring-amber-500">
                                <span class="ml-3 font-medium text-sm text-gray-700">Chắc Chắn Sẽ Đến</span>
                            </label>
                            <label class="flex items-center p-4 border border-gray-200 rounded-xl cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="attendance" value="no" class="text-amber-600 focus:ring-amber-500">
                                <span class="ml-3 font-medium text-sm text-gray-700">Rất Tiếc Không Thể</span>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block font-serif text-sm font-semibold text-gray-700 mb-2">Số Người Đi Cùng</label>
                        <select class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none transition-all">
                            <option value="1">1 Người (Chỉ mình tôi)</option>
                            <option value="2">2 Người</option>
                            <option value="3">3 Người</option>
                            <option value="4">Đi cùng gia đình</option>
                        </select>
                    </div>

                    <button type="submit" class="w-full py-4 bg-burgundy hover:bg-rose-900 text-amber-100 font-serif text-sm uppercase tracking-widest font-bold rounded-xl shadow-lg transform hover:-translate-y-0.5 transition-all">
                        Gửi Xác Nhận Tham Dự
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- SECTION 7: WISHES BOARD & FORM -->
    <section id="wishes" class="py-24 bg-softPink/40 relative">
        <div class="max-w-5xl mx-auto px-4">
            <div class="text-center mb-16" data-aos="fade-up">
                <span class="font-serif text-xs uppercase tracking-[0.3em] text-amber-700 block mb-2">Gửi Trao Yêu Thương</span>
                <h2 class="font-script text-5xl md:text-6xl text-burgundy">Sổ Lời Chúc</h2>
                <div class="w-16 h-0.5 bg-amber-600 mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <!-- Send Wish Form -->
                <div class="lg:col-span-5 bg-white rounded-3xl p-6 shadow-xl border border-amber-100" data-aos="fade-right">
                    <h3 class="font-serif text-2xl font-bold text-gray-800 mb-4">Gửi Lời Chúc</h3>
                    <form id="wishForm" onsubmit="addWish(event)" class="space-y-4">
                        <div>
                            <input type="text" id="wishName" required placeholder="Tên của bạn..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 outline-none text-sm">
                        </div>
                        <div>
                            <textarea id="wishMessage" required rows="4" placeholder="Nhập lời chúc ngọt ngào của bạn dành cho dâu rể..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-500 outline-none text-sm"></textarea>
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-600 hover:bg-amber-700 text-white font-serif text-xs uppercase tracking-widest font-bold rounded-xl shadow transition-all">
                            Gửi Lời Chúc
                        </button>
                    </form>
                </div>

                <!-- Wishes Wall -->
                <div class="lg:col-span-7 space-y-4 max-h-[500px] overflow-y-auto pr-2" id="wishesWall" data-aos="fade-left">
                    <!-- Default Initial Wish -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-amber-100/60">
                        <div class="flex justify-between items-center mb-2">
                            <h4 class="font-serif font-bold text-amber-800">Anh Tuấn & Phương Thảo</h4>
                            <span class="text-xs text-gray-400">Vừa xong</span>
                        </div>
                        <p class="text-gray-600 text-sm leading-relaxed italic">"Chúc hai bạn trăm năm hạnh phúc, sớm có quý tử nha! Luôn giữ nụ cười hạnh phúc như ngày hôm nay!"</p>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-amber-100/60">
                        <div class="flex justify-between items-center mb-2">
                            <h4 class="font-serif font-bold text-amber-800">Hội Bạn Thân Đại Học</h4>
                            <span class="text-xs text-gray-400">10 phút trước</span>
                        </div>
                        <p class="text-gray-600 text-sm leading-relaxed italic">"Mừng cho Minh Tú tìm được bến đỗ tuyệt vời. Chúc hai vợ chồng luôn đồng hành và thấu hiểu lẫn nhau."</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-12 bg-burgundy text-amber-100 text-center relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 relative z-10">
            <h2 class="font-script text-4xl md:text-5xl mb-4">Minh Tú & Khánh Linh</h2>
            <p class="font-serif text-xs uppercase tracking-[0.3em] text-amber-300 mb-6">Thank you for sharing our special day!</p>
            <p class="text-xs text-amber-200/60 font-sans">© 2026 Interactive Online Wedding Card</p>
        </div>
    </footer>

    <!-- LIGHTBOX MODAL FOR GALLERY -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4" onclick="closeLightbox()">
        <span class="absolute top-6 right-6 text-white text-3xl cursor-pointer">&times;</span>
        <img id="lightboxImg" src="" alt="Enlarged image" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl object-contain">
    </div>

    <!-- AUDIO FILE (Hidden background audio) -->
    <audio id="weddingAudio" loop>
        <source src="https://assets.mixkit.co/music/preview/mixkit-romantic-sunlight-600.mp3" type="audio/mpeg">
    </audio>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Initialize AOS Animations
        AOS.init({
            duration: 1000,
            once: false,
            mirror: true
        });

        // 1. Countdown Timer Logic
        const weddingDate = new Date('December 28, 2026 09:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            if (distance < 0) {
                document.getElementById('countdown').innerHTML = `<div class="col-span-4 text-amber-200 text-2xl font-serif">Đã diễn ra!</div>`;
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('days').innerText = days < 10 ? '0' + days : days;
            document.getElementById('hours').innerText = hours < 10 ? '0' + hours : hours;
            document.getElementById('minutes').innerText = minutes < 10 ? '0' + minutes : minutes;
            document.getElementById('seconds').innerText = seconds < 10 ? '0' + seconds : seconds;
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // 2. Music Player Toggle
        let isPlaying = false;
        const audio = document.getElementById('weddingAudio');
        const musicIcon = document.getElementById('musicIcon');

        function toggleMusic() {
            if (isPlaying) {
                audio.pause();
                musicIcon.classList.remove('animate-spin');
                musicIcon.classList.replace('fa-music', 'fa-volume-mute');
            } else {
                audio.play();
                musicIcon.classList.add('animate-spin');
                musicIcon.classList.replace('fa-volume-mute', 'fa-music');
            }
            isPlaying = !isPlaying;
        }

        // Auto play audio interaction trigger on scroll first time
        window.addEventListener('scroll', function initialPlay() {
            if (!isPlaying) {
                audio.play().then(() => {
                    isPlaying = true;
                    musicIcon.classList.add('animate-spin');
                }).catch(() => {
                    // Auto-play prevented by browser policy
                });
            }
            window.removeEventListener('scroll', initialPlay);
        });

        // 3. Falling Petals Effect
        function createPetal() {
            const container = document.getElementById('petal-container');
            const petal = document.createElement('div');
            petal.classList.add('petal');
            
            const size = Math.random() * 15 + 10;
            petal.style.width = `${size}px`;
            petal.style.height = `${size}px`;
            petal.style.left = `${Math.random() * 100}%`;
            petal.style.animationDuration = `${Math.random() * 5 + 5}s`;
            
            container.appendChild(petal);

            setTimeout(() => {
                petal.remove();
            }, 10000);
        }
        setInterval(createPetal, 400);

        // 4. Lightbox Gallery Logic
        function openLightbox(src) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightboxImg');
            img.src = src;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
        }

        // 5. RSVP Form Handler with Confetti
        function handleRSVP(event) {
            event.preventDefault();
            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });
            alert('Cảm ơn bạn đã xác nhận tham dự! Dâu rể rất hân hạnh được đón tiếp bạn.');
            document.getElementById('rsvpForm').reset();
        }

        // 6. Wishes Wall Dynamic Add
        function addWish(event) {
            event.preventDefault();
            const name = document.getElementById('wishName').value;
            const msg = document.getElementById('wishMessage').value;

            if(!name || !msg) return;

            const wall = document.getElementById('wishesWall');
            const newWish = document.createElement('div');
            newWish.className = 'bg-white p-6 rounded-2xl shadow-sm border border-amber-100/60 transform transition-all duration-500 scale-95 opacity-0';
            newWish.innerHTML = `
                <div class="flex justify-between items-center mb-2">
                    <h4 class="font-serif font-bold text-amber-800">${escapeHtml(name)}</h4>
                    <span class="text-xs text-gray-400">Vừa xong</span>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed italic">"${escapeHtml(msg)}"</p>
            `;

            wall.prepend(newWish);

            setTimeout(() => {
                newWish.classList.remove('scale-95', 'opacity-0');
            }, 50);

            document.getElementById('wishForm').reset();
            
            // Trigger celebration confetti
            confetti({
                particleCount: 50,
                spread: 50,
                origin: { y: 0.8 }
            });
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>
